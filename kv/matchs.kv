<ScoreButton>:
    size_hint: None, None
    size: dp(30), dp(30)
    radius: [dp(15)]
    pos_hint: {'center_y': 0.5}
    anchor_x: 'center'
    anchor_y: 'center'
    md_bg_color: self.couleur_desactivee if self.disabled else self.couleur
    MDIcon:
        icon: root.icon
        icon_color: root.icon_color
        icon_color_disabled: root.icon_color

<Matchs>:
    orientation: 'horizontal'
    size_hint_y: None
    md_bg_color: [0, 0, 0, 0]
    MDBoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.46

        PlayerButton:
            id: joueur_1
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(41)
            md_bg_color: [0.3, 0.3, 0.3, 0.7]
            md_bg_color_disabled: [0.2, 0.2, 0.2, 0.7]
            padding: dp(5), dp(3)
            spacing: dp(5)
            radius: [dp(8)]
            on_release: root.parier(1)
            Image:
                id: drapeau_joueur_1
                size_hint_x: None
                width: '25dp'
                source: ''
            MDLabel:
                id: nom_joueur_1
                text_color: 1,1,1,1
                theme_font_size: 'Custom'
                font_size: '12sp'
                text: ''
                halign: 'center'
                valign: 'middle'
            FitImage:
                id: photo_joueur_1
                size_hint: None, None
                size: dp(35), dp(35)
                radius: [dp(10)]
                source: ''
            MDLabel:
                id: resultat_joueur_1
                size_hint_x: None
                width: dp(10)
                text: ''
                text_color: [1,1,1,1]

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint: None, None
            size: dp(90), dp(32)
            pos_hint: {'center_x': 0.5}
            ScoreButton:
                id: moins_joueur_1
                icon: 'minus'
                couleur: [0.9, 0, 0, 0.7]
                on_release: root.modifier_score_pari(1, '-')
            MDBoxLayout:
                radius: [dp(7)]
                md_bg_color: [0.3, 0.3, 0.3, 0.7]
                MDLabel:
                    id: score_joueur_1
                    text: '0'
                    text_color: [0,0.5,1,1]
                    halign: 'center'
                    valign: 'middle'
            ScoreButton:
                id: plus_joueur_1
                icon: 'plus'
                couleur: [0, 0.9, 0, 0.7]
                on_release: root.modifier_score_pari(1, '+')


    MDBoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        width: dp(40)
        height: dp(41)
        pos_hint: {'top':1}
        Label:
            text: '\nVS'
            font_size: '12sp'
            color: [1,1,1,0.7]
            halign: 'center'
            valign: 'middle'
        Label:
            id: etat
            font_size: '10sp'
            color: [1,1,1,1]
            text: ''
            halign: 'center'
            valign: 'middle'


    MDBoxLayout:
        orientation: 'vertical'
        size_hint_x: 0.46

        PlayerButton:
            id: joueur_2
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(41)
            md_bg_color: [0.3, 0.3, 0.3, 0.7]
            md_bg_color_disabled: [0.2, 0.2, 0.2, 0.7]
            padding: dp(5), dp(3)
            spacing: dp(5)
            radius: [dp(8)]
            on_release: root.parier(2)
            MDLabel:
                id: resultat_joueur_2
                size_hint_x: None
                width: dp(10)
                text: ''
                text_color: [1,1,1,1]
            Image:
                id: drapeau_joueur_2
                size_hint_x: None
                width: '25dp'
                source: ''
            MDLabel:
                id: nom_joueur_2
                text_color: 1,1,1,1
                theme_font_size: 'Custom'
                font_size: '12sp'
                text: ''
                halign: 'center'
                valign: 'middle'
            FitImage:
                id: photo_joueur_2
                size_hint: None, None
                size: dp(35), dp(35)
                radius: [dp(10)]
                source: ''

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint: None, None
            size: dp(90), dp(32)
            pos_hint: {'center_x': 0.5}
            ScoreButton:
                id: moins_joueur_2
                icon: 'minus'
                couleur: [0.9, 0, 0, 0.7]
                on_release: root.modifier_score_pari(2, '-')
            MDBoxLayout:
                radius: [dp(7)]
                md_bg_color: [0.3, 0.3, 0.3, 0.7]
                MDLabel:
                    id: score_joueur_2
                    text: '0'
                    text_color: [0,0.5,1,1]
                    halign: 'center'
                    valign: 'middle'
            ScoreButton:
                id: plus_joueur_2
                icon: 'plus'
                couleur: [0, 0.9, 0, 0.7]
                on_release: root.modifier_score_pari(2, '+')
