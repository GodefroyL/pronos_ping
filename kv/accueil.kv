<Accueil>:
    id: accueil
    name: 'accueil'
    md_bg_color: 0,0,0,0
    FitImage:
        source: 'images/fond_ecran.jpeg'
    
    BoxLayout:
        orientation: 'vertical'
        padding: dp(5)

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: (0.1)

            Label:
                text: app.titre
                pos: (0.7, 0.5)

            MDIconButton:
                size_hint: 0.1, 1
                pos_hint: {"right": 0.7}
                icon: 'book-settings'
            
                on_release: app.aller(page='regles', direction='up')
            MDIconButton: 
                size_hint: 0.1, 1
                pos_hint: {"right": 0.9}
                icon: 'cog'

                on_release: app.aller(page='parametres', direction='up')

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: (0.1)
            Button:
                text: 'ligue'
                on_press: app.aller(page='ligues',direction='left')
            Label:
                text: 'accueil'
            Button:
                text: 'classement'
                on_press: app.aller(page='classements', direction='right')

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: (0.1)
            Label:
                text: 'Championnat :'    
            Spinner:
                id: championnat
                text: 'Champions de Montpellier'
                values: ['Champions de Montpellier','Champions de Frankfort', 'China smash', 'WTT Finals']
                on_text: self.root.maj_donnee
              
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: (0.1)
            Label:
                text: 'Tour :'    
            Spinner:
                id: tour
                text: 'Quart de finale'
                values: ['Tous', 'Quart de finale', 'Demi finale', 'Finale']
                on_text: self.root.maj_donnee

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: (0.1)
            Label:
                text: 'Sexe :'
            Spinner:
                id: sexe
                text: 'tous'
                values: ['tous', 'f', 'h']
                on_text: root.maj_donnee()

        BoxLayout:
            id: matchs
            orientation: 'vertical'                

        Label:
            size_hint_y: (0.1)
            text: 'pub'
